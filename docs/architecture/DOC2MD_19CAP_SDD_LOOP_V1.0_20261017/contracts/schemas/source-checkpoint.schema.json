      "title": "Committed Event Ids",
      "type": "array"
    },
    "enumeration_complete": {
      "title": "Enumeration Complete",
      "type": "boolean"
    },
    "selection_scope_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Scope Hash",
      "type": "string"
    },
    "authorization_snapshot_ref": {
      "minLength": 1,
      "title": "Authorization Snapshot Ref",
      "type": "string"
    }
