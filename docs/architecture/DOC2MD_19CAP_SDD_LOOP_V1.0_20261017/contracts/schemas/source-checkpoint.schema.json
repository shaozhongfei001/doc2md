  "required": [
    "schema_version",
    "source_id",
    "generation_id",
    "previous_generation_id",
    "cursor_token",
    "cursor_sha256",
    "committed_event_ids",
    "enumeration_complete",
    "selection_scope_hash",
    "authorization_snapshot_ref"
  ],
  "title": "SyncCheckpoint",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doc2md:19cap:source-checkpoint:1.0",
