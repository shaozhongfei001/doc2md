{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "enum": [
            "EXTENSION",
            "RAW_VAULT",
            "PARSED"
          ],
          "title": "Root",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "root",
        "relative_path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "source-version/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_version_id": {
      "minLength": 1,
      "title": "Source Version Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "external_object_id": {
      "minLength": 1,
      "title": "External Object Id",
      "type": "string"
    },
    "version_kind": {
      "enum": [
        "SOURCE_NATIVE",
        "LOCAL_SNAPSHOT"
      ],
      "title": "Version Kind",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Revision"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Snapshot Id"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Sha256"
    },
    "legacy_query_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
