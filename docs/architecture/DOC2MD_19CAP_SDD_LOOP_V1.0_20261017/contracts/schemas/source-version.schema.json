      "type": "string"
    },
    "permission_ref": {
      "minLength": 1,
      "title": "Permission Ref",
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "title": "Owner Ref",
      "type": "string"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "Classification",
      "type": "string"
    },
    "purpose_scopes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Purpose Scopes",
      "type": "array"
    },
    "license_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "License Ref"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valid To"
    },
    "source_file_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileRef"
        },
        {
          "type": "null"
        }
      ]
