  "required": [
    "schema_version",
    "source_version_id",
    "source_id",
    "external_object_id",
    "version_kind",
    "source_revision",
    "snapshot_id",
    "content_sha256",
    "legacy_query_ref",
    "processing_route",
    "source_kind",
    "authority_class",
    "permission_ref",
    "owner_ref",
    "classification",
    "purpose_scopes",
    "license_ref",
    "valid_from",
    "valid_to",
    "source_file_ref"
  ],
  "title": "SourceVersion",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doc2md:19cap:source-version:1.0",
  "x-contract-state": "DESIGN_CANDIDATE"
}
