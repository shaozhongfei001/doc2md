{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "source-event/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "external_object_id": {
      "minLength": 1,
      "title": "External Object Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "UPSERT",
        "REVOKE",
        "DELETE",
        "RESTORE"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "source_version_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Version Id"
    },
    "source_order_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Order Token"
    },
    "source_epoch": {
      "minimum": 0,
      "title": "Source Epoch",
      "type": "integer"
    },
    "access_revision": {
      "minLength": 1,
      "title": "Access Revision",
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source_id",
    "external_object_id",
    "event_type",
    "source_version_id",
    "source_order_token",
    "source_epoch",
    "access_revision",
    "payload_hash",
    "observed_at"
  ],
  "title": "SourceEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
